# --- Database ---
# Get a free Postgres database from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Admin dashboard ---
# Password church staff use to sign in at /admin/login
ADMIN_PASSWORD="change-this-password"
# Random long string used to sign admin session cookies. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="change-this-to-a-random-64-character-string"

# --- Giving instructions shown after "Give now" ---
NEXT_PUBLIC_PAYBILL_NUMBER="000000"
NEXT_PUBLIC_PAYBILL_ACCOUNT="MEDIA FUND"

# --- QR code / links ---
# Your deployed site URL (used to generate the QR code). Leave unset in local dev.
NEXT_PUBLIC_SITE_URL="https://your-church-site.vercel.app"
